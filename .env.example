# Party Harness local key file.
#
# Copy this file to `.env` (same folder as server.js) and fill in what you use.
# server.js reads it once at boot. Keys set here never reach the browser, and you
# stop re-entering them on every refresh -- browser-entered keys are memory-only
# by design and disappear when you reload the page.
#
# A real environment variable always wins over a value here.
#
# This is plaintext on disk: it is exactly as private as this folder. Nothing in
# the harness serves it, but do not commit it or put it in a synced folder you
# share. If you would rather not have keys on disk at all, leave this file absent
# and keep using the Settings fields.

# --- Text generation -------------------------------------------------------
# OPENAI_API_KEY=sk-...
# NOVELAI_API_KEY=pst-...

# --- Image generation (optional) -------------------------------------------
# Falls back to the matching text key above when unset.
# OPENAI_IMAGE_API_KEY=sk-...
# NOVELAI_IMAGE_API_KEY=pst-...
# STABILITY_API_KEY=your-stability-key
# COMPATIBLE_IMAGE_API_KEY=your-custom-image-server-key

# --- Models and port (optional) --------------------------------------------
# OPENAI_MODEL=gpt-5.6-luna
# OPENAI_IMAGE_MODEL=gpt-image-2
# RP_PORT=8787

# --- Additional text providers (optional) ---
# ANTHROPIC_API_KEY=your-key-here
# GEMINI_API_KEY=your-key-here
# OPENROUTER_API_KEY=your-key-here
# DEEPSEEK_API_KEY=your-key-here
# GROQ_API_KEY=your-key-here
# COMPATIBLE_API_KEY=your-custom-server-key
# Ollama and LM Studio do not require a key unless you enable authentication.
